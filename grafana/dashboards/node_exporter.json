{
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{
        "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
        "legendFormat": "CPU",
        "refId": "A"
      }],
      "title": "CPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{
        "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
        "legendFormat": "память",
        "refId": "A"
      }],
      "title": "Память",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [
        {"expr": "sum(rate(node_network_receive_bytes_total[1m]))", "legendFormat": "вход", "refId": "A"},
        {"expr": "sum(rate(node_network_transmit_bytes_total[1m]))", "legendFormat": "выход", "refId": "B"}
      ],
      "title": "Сеть",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [
        {"expr": "sum(rate(node_disk_read_bytes_total[1m]))", "legendFormat": "чтение", "refId": "A"},
        {"expr": "sum(rate(node_disk_written_bytes_total[1m]))", "legendFormat": "запись", "refId": "B"}
      ],
      "title": "Диск",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["host"],
  "time": {"from": "now-15m", "to": "now"},
