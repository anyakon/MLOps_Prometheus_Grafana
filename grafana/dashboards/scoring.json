{
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "rate(scorings_total[1m])", "legendFormat": "записей/с", "refId": "A"}],
      "title": "Скорость записи в базу",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{
        "expr": "rate(scoring_db_write_seconds_sum[1m]) / rate(scoring_db_write_seconds_count[1m])",
        "legendFormat": "секунды",
        "refId": "A"
      }],
      "title": "Время записи",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "fraud_detected_total", "legendFormat": "фрод", "refId": "A"}],
      "title": "Число выявленного фрода",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(scoring_fraud_score_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scoring_fraud_score_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "title": "Распределение записанных скоров",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "postgres", "uid": "postgres_fraud"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "targets": [{
        "editorMode": "code",
        "format": "table",
        "rawQuery": true,
        "rawSql": "SELECT COALESCE(model_version, 'unknown') AS model_version, count(*) AS scores, round(avg(fraud_flag)::numeric, 4) AS fraud_rate FROM scores GROUP BY 1 ORDER BY scores DESC",
        "refId": "A"
      }],
      "title": "Скоры и доля фрода по версии модели",
      "type": "table"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["fraud"],
  "time": {"from": "now-15m", "to": "now"},
  "title": "Запись скоров",
  "uid": "hw5-score-writer",
  "version": 1
}
