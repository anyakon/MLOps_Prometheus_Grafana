{
  "annotations": {
    "list": [
      {
        "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
        "enable": true,
        "expr": "model_version_updates_total unless model_version_updates_total offset 30s",
        "hide": false,
        "iconColor": "red",
        "name": "Смена модели",
        "step": "1s",
        "textFormat": "Скоринг перешёл на {{version}}",
        "titleFormat": "Модель {{version}}"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "rate(transactions_total[1m])", "legendFormat": "транзакций/с", "refId": "A"}],
      "title": "Скорость потока",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{
        "expr": "rate(transaction_processing_seconds_sum[1m]) / rate(transaction_processing_seconds_count[1m])",
        "legendFormat": "секунды",
        "refId": "A"
      }],
      "title": "Время обработки одной транзакции",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "fraud_ratio", "legendFormat": "доля фрода", "refId": "A"}],
      "title": "Доля фрода",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fraud_score_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fraud_score_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "title": "Распределение скоров во времени",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hw5-prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "targets": [{"expr": "rate(high_risk_transactions_total[1m])", "legendFormat": "скор >= 0.9, в секунду", "refId": "A"}],
      "title": "Очень высокий скор",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["fraud"],
  "time": {"from": "now-15m", "to": "now"},
  "title": "Скоринг потока",
  "uid": "hw5-scoring-stream",
  "version": 1
}
